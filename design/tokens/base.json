          "hex": "#05f7f4"
        },
        "$description": "Logo 'CO'. The system at work: primary action in the dark theme, live state, selection."
      },
      "amber": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.9725,
            0.7216,
            0.3412
