{
  "name": "htco-clients",
  "version": "0.0.0",
  "private": true,
  "description": "HTCO OS clients: web, Android and Windows apps, design tokens and generated API clients.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "check": "pnpm run lint && pnpm run typecheck && pnpm run i18n:check && pnpm run test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "typecheck": "tsc --project tsconfig.json && tsc --project apps/web/tsconfig.json",
    "test": "vitest run",
    "tokens": "pnpm --filter @htco/design-tokens build",
    "i18n:check": "pnpm --filter @htco/web exec lingui check sync && pnpm --filter @htco/web exec lingui check missing",
    "web": "pnpm --filter @htco/web dev",
    "storybook": "pnpm --filter @htco/web storybook",
    "test:storybook": "pnpm --filter @htco/web test:storybook",
    "test:e2e": "pnpm --filter @htco/web storybook:build && pnpm --filter @htco/web test:e2e",
    "api:generate": "pnpm --filter @htco/api-client generate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
